# ---- Bot → MCP（Grok Bot 连接时放在 Authorization: Bearer ...）----
DOUYIN_MCP_API_KEY=change-me-to-a-long-random-string

# ---- 服务监听 ----
PORT=8787
HOST=0.0.0.0
# 公网 HTTPS 基址（部署后填写，用于文档与回调说明）
PUBLIC_BASE_URL=https://your-mcp.example.com

# ---- 抖音开放平台应用凭证（open.douyin.com 控制台）----
DOUYIN_CLIENT_KEY=your_client_key
DOUYIN_CLIENT_SECRET=your_client_secret
# 必须与控制台「授权回调」一致；本服务默认在 /oauth/callback 接 code
DOUYIN_REDIRECT_URI=https://your-mcp.example.com/oauth/callback

# ---- OAuth scope（逗号分隔；按你已申请的权限改）----
# 常用：user_info,video.create.bind,video.list
# 旧版也可能是 video.create；评论相关 Phase4：item.comment / video.comment
DOUYIN_SCOPES=user_info,video.create.bind,video.list

# ---- Token 存储路径（默认 ./data/tokens.json）----
DOUYIN_TOKEN_STORE=./data/tokens.json
